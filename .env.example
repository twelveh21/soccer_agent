# 复制为 .env 后填写自己的 Key。不要把真实 Key 提交或分享给其他人。
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SOCCER_AGENT_MODEL=qwen3.5-35b-a3b
SOCCER_AGENT_LIGHT_MODEL=qwen3.5-plus
SOCCER_AGENT_VISION_MODEL=qwen-vl-plus

# PostgreSQL：后端服务化阶段使用。未配置时，现有 SQLite Agent 仍可独立运行。
# 示例：postgresql+psycopg://soccer_agent:change_me@localhost:5432/soccer_agent
DATABASE_URL=
POSTGRES_PASSWORD=soccer_agent_dev_password

# Redis：实时数据缓存、限流与后台任务队列共用的内存服务。
# 本机 Docker 默认地址；生产环境需改为托管 Redis 地址并配置密码。
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 鉴权：生产环境必须替换为随机长密钥，且不要提交真实值。
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=120
# 首次注册该邮箱时自动授予 admin；仅限本地初始化，生产环境应改用受审计的管理员管理流程。
SOCCER_AGENT_BOOTSTRAP_ADMIN_EMAIL=your_admin@example.com

# 可观测性：不填则仅保存本地 data/observability/traces.jsonl；填入后会额外发往 OTLP 平台。
# 示例：http://localhost:6006/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# football-data.org：赛程、积分榜、球队与球员等结构化资料
FOOTBALL_DATA_API_KEY=your_football_data_api_key
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# Tavily：伤停、转会、新闻和公开战术资料检索
TAVILY_API_KEY=your_tavily_api_key

# 可选：仅用于运行报告里的成本估算，不会影响调用本身
# SOCCER_INPUT_USD_PER_M_TOKEN=0
# SOCCER_OUTPUT_USD_PER_M_TOKEN=0
