# 阿里云百炼（请使用你自己的真实 Key；不要把真实 .env 提交到 Git）
DASHSCOPE_API_KEY=你的_DashScope_Key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 足球 Agent 模型网关（不填角色覆盖时，默认全用 SOCCER_AGENT_MODEL）
SOCCER_AGENT_MODEL=qwen3.5-35b-a3b
# 可选：Planner、Critic、实时资料整理等轻量节点使用的低成本模型
SOCCER_AGENT_LIGHT_MODEL=
# 单次模型请求的超时和自动重试上限，防止工作流无限等待或反复消耗额度
SOCCER_AGENT_MODEL_TIMEOUT_SECONDS=25
SOCCER_AGENT_MODEL_MAX_RETRIES=1
# 可选角色覆盖：SOCCER_AGENT_PLANNER_MODEL=；SOCCER_AGENT_SOLVER_MODEL=；SOCCER_AGENT_CRITIC_MODEL=

# football-data.org（注册后替换 Key）
FOOTBALL_DATA_API_KEY=你的_football_data_Key
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# SQLite 缓存（可选；不填则默认保存在项目 data/tool_cache.db）
SOCCER_CACHE_DB_PATH=

# Tavily（仅在免费足球数据不可用或不覆盖时作为网页检索兜底）
TAVILY_API_KEY=你的_Tavily_Key
